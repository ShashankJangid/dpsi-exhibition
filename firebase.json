{
  "database": {
    "rules": "database.rules.json"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "firebase-functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "auth": {
    "providers": {
      "anonymous": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "DPSI Exhibition 2026",
        "supportEmail": "admin@dpsi-visitor.in",
        "authorizedRedirectUris": [
          "https://smarthome-88486.firebaseapp.com/__/auth/handler",
          "http://localhost:3000",
          "https://dpsiexibition.pages.dev/__/auth/handler",
          "https://dpsiexibition.pages.dev"
        ]
      }
    }
  }
}
