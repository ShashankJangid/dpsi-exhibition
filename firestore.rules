rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (
          request.auth.token.admin == true ||
          request.auth.token.role == 'admin' ||
          (
            request.auth.token.email != null &&
            request.auth.token.email_verified == true &&
            request.auth.token.email in [
              'admin@dpsi-visitor.in',
              'admin@dpsites.org'
            ]
          )
        );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidOptionalString(data, field, minLen, maxLen) {
      return !(field in data) ||
        (data[field] is string && data[field].size() >= minLen && data[field].size() <= maxLen);
    }

    function isValidImageUrl(url) {
      return url is string &&
        url.size() > 0 &&
        url.size() <= 1000 &&
        (url.matches("^https://.*") || url.matches("^http://.*") || url.matches("^/.*"));
    }

    function isValidProject(data) {
      let requiredFields = [
        'title', 'zone', 'category', 'booth_code', 'booth_number',
        'position_x', 'position_y', 'position_z', 'image_url',
        'description', 'members', 'vote_count'
      ];
      let allowedFields = [
        'id', 'title', 'zone', 'category', 'booth_code', 'booth_number',
        'position_x', 'position_y', 'position_z', 'image_url',
        'description', 'tagline', 'members', 'tech_stack', 'vote_count',
        'created_at', 'createdAt', 'updated_at', 'updatedAt'
      ];

      return data.keys().hasAll(requiredFields) &&
        data.keys().hasOnly(allowedFields) &&
        isValidString(data.title, 1, 200) &&
        data.zone in ['zone-1', 'zone-2', 'zone-3'] &&
        data.category in ['Show & Tell', 'Physical', 'Digital', 'Business', 'Robo Race', 'Robo Soccer'] &&
        isValidString(data.booth_code, 1, 20) &&
        data.booth_number is number && data.booth_number >= 0 && data.booth_number <= 1000 &&
        data.position_x is number && data.position_x >= -500 && data.position_x <= 500 &&
        data.position_y is number && data.position_y >= -500 && data.position_y <= 500 &&
        data.position_z is number && data.position_z >= -500 && data.position_z <= 500 &&
        isValidImageUrl(data.image_url) &&
        isValidString(data.description, 1, 5000) &&
        data.members is list && data.members.size() > 0 && data.members.size() <= 20 &&
        data.vote_count is number && data.vote_count >= 0 &&
        (!('id' in data) || isValidString(data.id, 1, 50)) &&
        isValidOptionalString(data, 'tagline', 0, 500) &&
        (!('tech_stack' in data) || (data.tech_stack is list && data.tech_stack.size() <= 30));
    }

    // ===============================================================
    // Root Default Deny
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Collection: projects
    // ===============================================================
    match /projects/{projectId} {
      // Public read allowed for real-time exhibition leaderboard & 3D floor plan
      allow read: if true;

      // Projects can be created by Admins or seeded with valid exhibition schema at vote_count == 0
      allow create: if (isAdmin() && isValidProject(request.resource.data))
        || (isValidProject(request.resource.data) && request.resource.data.vote_count == 0);

      allow delete: if isAdmin();

      // Updates: Administrators can update full project details.
      // Verified community voters can ONLY atomically increment vote_count by exactly +1 in a transaction.
      allow update: if (isAdmin() && isValidProject(request.resource.data))
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vote_count', 'updatedAt'])
          && request.resource.data.vote_count == resource.data.vote_count + 1
        );
    }

    // ===============================================================
    // Collection: votes (Zero-Trust Anti-Cheat Audit Ledger)
    // ===============================================================
    match /votes/{voteId} {
      // PII Protection: Only allow reading own vote or admin audit; disallow public listing
      allow get: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();

      // Direct client creation is locked down to prevent spoofed fingerprint injection causing 409 collisions.
      // All legitimate ballots are committed server-side via Cloud Functions / Edge Functions using the Firebase Admin SDK.
      allow write: if false;
    }

    // ===============================================================
    // Collection: user_votes (Account Level Anti-Cheat)
    // ===============================================================
    match /user_votes/{userVoteId} {
      // Users can only read their own cast vote receipts; writes must be server-side Admin SDK
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow write: if false;
    }
  }
}
